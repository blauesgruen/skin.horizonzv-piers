<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="View_15_LiveTVChannelList">
        <param name="viewid">15</param>
        <definition>
            <control type="group">
                <description>Recordings group</description>
                <top>318</top>
                <include>openclose</include>
                <include>opencloseslideup</include>
                <visible>Control.IsVisible($PARAM[viewid])</visible>
                <control type="group">
                    <width>50%</width>
                    <control type="group">
                        <top>SpacePadding</top>
                        <bottom>SpacePadding</bottom>
                        <control type="fixedlist" id="$PARAM[viewid]">
                            <left>SpacePaddingLarge</left>
                            <onright>$PARAM[viewid]1</onright>
                            <onleft>9000</onleft>
                            <onup>$PARAM[viewid]</onup>
                            <ondown>$PARAM[viewid]</ondown>
                            <viewtype label="535">list</viewtype>
                            <movement>2</movement>
                            <focusposition>3</focusposition>
                            <pagecontrol>$PARAM[viewid]1</pagecontrol>
                            <scrolltime>200</scrolltime>
                            <orientation>vertical</orientation>
                            <include content="LiveTVChannelViewLayout">
                                <param name="id" value="$PARAM[viewid]" />
                                <param name="item_width" value="auto" />
                            </include>
                        </control>
                        <control type="scrollbar" id="$PARAM[viewid]1">
                            <left>100%</left>
                            <height>100%</height>
                            <onright>9000</onright>
                            <onleft>$PARAM[viewid]</onleft>
                            <showonepage>false</showonepage>
                            <orientation>vertical</orientation>
                        </control>
                    </control>
                </control>
                <control type="group">
                    <width>50%</width>
                    <right>0</right>
                    <control type="group">
                        <left>12</left>
                        <control type="image">
                            <texture>BlackBack.png</texture>
                        </control>
                        <control type="group">
                            <left>SpacePaddingLarge</left>
                            <right>SpacePaddingLarge</right>
                            <bottom>SpacePaddingLarge</bottom>
                            <include>PVRInfoPanel</include>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>
    <include name="View_9_LiveTVChannelPanel">
        <param name="viewid">9</param>
        <definition>
            <control type="group">
                <!-- TV Channels group -->
                <description>TV Channels group</description>
                <visible>Control.IsVisible(9)</visible>
                <include>openclose</include>
                <include>opencloseslideup</include>
                <control type="panel" id="$PARAM[viewid]">
                    <!-- <left>112</left>
                    <right>112</right> -->
                    <centerleft>50%</centerleft>
                    <width>1760</width>
                    <top>336</top>
                    <bottom>SpacePadding</bottom>
                    <onleft>9000</onleft>
                    <onright>9</onright>
                    <onup>9</onup>
                    <ondown>9</ondown>
                    <viewtype label="panel">panel</viewtype>
                    <pagecontrol>70</pagecontrol>
                    <scrolltime>200</scrolltime>
                    <orientation>horizontal</orientation>
                    <include content="LiveTVChannelViewLayout">
                        <param name="id" value="$PARAM[viewid]" />
                        <param name="item_width" value="880" />
                    </include>
                </control>
                <control type="group">
                    <top>315</top>
                    <control type="group">
                        <centertop>50%</centertop>
                        <height>180</height>
                        <control type="group">
                            <visible>Container(9).HasNext</visible>
                            <include>openclosevisible</include>
                            <control type="image">
                                <left>60r</left>
                                <width>1</width>
                                <colordiffuse>menudiffuse</colordiffuse>
                                <texture>Separator3.png</texture>
                            </control>
                            <control type="image">
                                <left>50r</left>
                                <top>62</top>
                                <width>30</width>
                                <height>45</height>
                                <colordiffuse>menudiffuse</colordiffuse>
                                <texture flipx="true">ArrowBig.png</texture>
                            </control>
                        </control>
                        <control type="group">
                            <visible>Container(9).HasPrevious</visible>
                            <include>openclosevisible</include>
                            <control type="image">
                                <left>60</left>
                                <width>1</width>
                                <height>180</height>
                                <colordiffuse>menudiffuse</colordiffuse>
                                <texture>Separator3.png</texture>
                            </control>
                            <control type="image">
                                <left>21</left>
                                <top>62</top>
                                <width>30</width>
                                <height>45</height>
                                <colordiffuse>menudiffuse</colordiffuse>
                                <texture>ArrowBig.png</texture>
                            </control>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>
    <include name="View_14_LiveTVChannelIcons">
        <control type="group">
            <!-- TV Channels group -->
            <description>TV Channels group</description>
            <visible>Control.IsVisible(14)</visible>
            <include>openclose</include>
            <include>opencloseslideup</include>
            <control type="group">
                <left>105</left>
                <right>105</right>
                <control type="panel" id="14">
                    <top>336</top>
                    <bottom>300</bottom>
                    <onleft>9000</onleft>
                    <onright>14</onright>
                    <onup>14</onup>
                    <ondown>14</ondown>
                    <viewtype label="Icons">panel</viewtype>
                    <pagecontrol>70</pagecontrol>
                    <scrolltime>200</scrolltime>
                    <orientation>horizontal</orientation>
                    <include>LiveTVChannelViewLayout</include>
                </control>
                <control type="group">
                    <left>5</left>
                    <height>260</height>
                    <bottom>SpacePaddingLarge</bottom>
                    <control type="image">
                        <colordiffuse>$VAR[BackgroundOverlayColorDialog]</colordiffuse>
                        <texture border="4">WhiteBack$VAR[CornerSettingVar].png</texture>
                    </control>
                    <control type="image">
                        <colordiffuse>grey</colordiffuse>
                        <texture border="4">masks/Default$VAR[CornerSettingVar].png</texture>
                    </control>
                    <control type="grouplist">
                        <left>20</left>
                        <right>20</right>
                        <top>10</top>
                        <aligny>top</aligny>
                        <itemgap>8</itemgap>
                        <orientation>vertical</orientation>
                        <control type="label">
                            <height>40</height>
                            <label>$INFO[ListItem.Title]</label>
                            <font>ubuntu-r21b</font>
                        </control>
                        <control type="progress">
                            <description>Progressbar</description>
                            <top>150</top>
                            <height>8</height>
                            <visible>ListItem.HasEpg</visible>
                            <info>ListItem.Progress</info>
                        </control>
                        <control type="textbox">
                            <textcolor>white</textcolor>
                            <height>220</height>
                            <align>left</align>
                            <aligny>top</aligny>
                            <include condition="!Skin.HasSetting(BigPlotText)">PlotText16Var</include>
                            <include condition="Skin.HasSetting(BigPlotText)">PlotTextBigVar</include>
                            <label>$INFO[ListItem.Plot]</label>
                        </control>
                    </control>
                </control>
            </control>
            <control type="group">
                <top>315</top>
                <bottom>300</bottom>
                <control type="group">
                    <centertop>50%</centertop>
                    <height>180</height>
                    <visible>Container(14).HasNext</visible>
                    <include>openclosevisible</include>
                    <control type="image">
                        <left>60r</left>
                        <width>1</width>
                        <colordiffuse>menudiffuse</colordiffuse>
                        <texture>Separator3.png</texture>
                    </control>
                    <control type="image">
                        <left>50r</left>
                        <top>64</top>
                        <width>30</width>
                        <height>45</height>
                        <colordiffuse>menudiffuse</colordiffuse>
                        <texture flipx="true">ArrowBig.png</texture>
                    </control>
                </control>
                <control type="group">
                    <centertop>50%</centertop>
                    <height>180</height>
                    <visible>Container(14).HasPrevious</visible>
                    <include>openclosevisible</include>
                    <control type="image">
                        <left>60</left>
                        <width>1</width>
                        <height>180</height>
                        <colordiffuse>menudiffuse</colordiffuse>
                        <texture>Separator3.png</texture>
                    </control>
                    <control type="image">
                        <left>21</left>
                        <top>64</top>
                        <width>30</width>
                        <height>45</height>
                        <colordiffuse>menudiffuse</colordiffuse>
                        <texture>ArrowBig.png</texture>
                    </control>
                </control>
            </control>
        </control>
    </include>
</includes>
