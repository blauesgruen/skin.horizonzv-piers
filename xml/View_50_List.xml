<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="View_50_List">
		<param name="viewid">50</param>
		<definition>
			<control type="group">
				<visible>Control.IsVisible($PARAM[viewid])</visible>
				<include>openclosemedium</include>
				<control type="group">
					<include>openclose</include>
					<include>openclosevisible</include>
					<visible>Control.IsVisible($PARAM[viewid])+!Control.HasFocus(666)</visible>
					<include>BlackGrunge</include>
				</control>
				<control type="group"> <!-- Mirror Panel -->
					<top>58%</top>
					<include>opencloseslideup</include>
					<visible>Control.IsVisible($PARAM[viewid])+!Control.HasFocus(666)</visible>
					<include content="MirrorPanel">>
						<param name="top" value="260" />
					</include>
				</control>
				<control type="group">
					<include>openclose</include>
					<include>opencloseslideright</include>
					<visible>Control.IsVisible($PARAM[viewid])+!Control.HasFocus(666)</visible>
					<animation type="Conditional" condition="[ControlGroup(9000).HasFocus()|ControlGroup(90000).HasFocus()|ControlGroup(9001).HasFocus()| ControlGroup(9002).HasFocus()] + Skin.HasSetting(animation)">
						<effect type="zoom" center="0,50" start="100" end="105" time="250" />
						<effect type="slide" start="0" end="490" time="250" />
					</animation>
					<include content="sidefade_shadow">
						<param name="id" value="$PARAM[viewid]" />
					</include>
					<control type="group">
						<left>InlayLeft</left>
						<right>InlayRight</right>
						<top>InlayTop</top>
						<include content="ScrollOffsetLabel">
							<param name="left">20r</param>
							<param name="top">20</param>
						</include>
					</control>
					<include content="InfoListPanel">
						<param name="left" value="InlayLeft" />
						<param name="right" value="InlayRight" />
					</include>
					<control type="group">
						<left>InlayLeft</left>
						<right>InlayRight</right>
						<top>InlayTop</top>
						<bottom>InlayBottom</bottom>
						<control type="list" id="$PARAM[viewid]">
							<animation effect="slide" end="8" condition="!Control.IsVisible($PARAM[viewid]1)">Conditional</animation>
							<left>60</left>
							<right>75</right>
							<top>80</top>
							<bottom>80</bottom>
							<onleft>9000</onleft>
							<onright condition="Control.IsVisible($PARAM[viewid]1)">$PARAM[viewid]1</onright>
							<onright condition="!Control.IsVisible($PARAM[viewid]1)+Control.IsVisible(15000)">15000</onright>
							<onright condition="!Control.IsVisible($PARAM[viewid]1)+!Control.IsVisible(15000)">732</onright>
							<onup>$PARAM[viewid]</onup>
							<ondown>$PARAM[viewid]</ondown>
							<pagecontrol>$PARAM[viewid]1</pagecontrol>
							<viewtype label="50">list</viewtype>
							<scrolltime>200</scrolltime>
							<include content="DefaultViewListLayout">
								<param name="list_id" value="$PARAM[viewid]" />
							</include>
						</control>
						<include content="DefaultScrollbar">
							<param name="top" value="80" />
							<param name="bottom" value="80" />
							<param name="id" value="$PARAM[viewid]1" />
							<param name="left" value="60r" />
							<param name="height" value="100%" />
							<param name="onleft" value="$PARAM[viewid]" />
						</include>
					</control>
					<include content="TMDbhelper_Provider_Icon">
						<param name="id" value="$PARAM[viewid]" />
						<param name="left" value="SpacePadding" />
						<param name="width" value="100%" />
					</include>
				</control>
				<control type="group">
					<include>openclose</include>
					<include>openclosevisible</include>
					<visible>Control.IsVisible($PARAM[viewid])+!Control.HasFocus(666)</visible>
					<control type="group"> <!-- Poster/Clearlogo -->
						<left>59.5%</left>
						<right>0</right>
						<top>InlayTop</top>
						<bottom>InlayBottom</bottom>
						<animation type="Conditional" condition="[ControlGroup(9000).HasFocus()|ControlGroup(90000).HasFocus()|ControlGroup(9001).HasFocus()| ControlGroup(9002).HasFocus()] + Skin.HasSetting(animation)">
							<effect type="fade" start="100" end="0" time="250" />
							<effect type="slide" start="0" end="600" time="250" />
						</animation>
						<include>opencloseslideleft</include>
						<visible>Control.IsVisible($PARAM[viewid])+!Control.HasFocus(666)</visible>
						<control type="group">
							<left>100</left>
							<right>100</right>
							<top>SpacePaddingLarge</top>
							<bottom>SpacePaddingLarge</bottom>
							<include>openclose</include>
							<include>openclosemedium</include>
							<visible>!Window.IsVisible(movieinformation)</visible>
							<control type="image">
								<include>opencloseslow</include>
								<animation effect="slide" end="0,150" condition="Container.Content(episodes)">Conditional</animation>
								<height>120</height>
								<aspectratio align="center" aligny="center">keep</aspectratio>
								<texture diffuse="masks/mask_flagging.png">$VAR[ClearlogoVAR]</texture>
								<visible>Skin.HasSetting(EnableExtendedArt)</visible>
							</control>
							<control type="image">
								<top>170</top>
								<aspectratio align="center" aligny="bottom">keep</aspectratio>
								<texture>$VAR[PosterThumb]</texture>
								<bordertexture border="20">masks/mask_frame.png</bordertexture>
								<bordersize>16</bordersize>
								<include>openclosevisible</include>
								<visible>![String.IsEmpty(ListItem.DBID)|String.Contains(System.CurrentControl,*)]|String.EndsWith(ListItem.Icon,jpg)</visible>
							</control>
							<control type="group">
								<bottom>0</bottom>
								<height>400</height>
								<control type="image">
									<aspectratio align="center" aligny="bottom">keep</aspectratio>
									<texture>$VAR[PosterThumb]</texture>
									<bordertexture border="20">masks/mask_frame.png</bordertexture>
									<bordersize>12</bordersize>
									<include>openclosevisible</include>
									<visible>[String.IsEmpty(ListItem.DBID)|String.Contains(System.CurrentControl,*)]+!String.EndsWith(ListItem.Icon,jpg)</visible>
								</control>
							</control>
						</control>
					</control>
					<control type="group">
						<animation type="Conditional" condition="ControlGroup(9000).HasFocus()|ControlGroup(90000).HasFocus()|ControlGroup(9001).HasFocus()| ControlGroup(9002).HasFocus()">
							<effect type="slide" start="0" end="0,150" time="250" />
						</animation>
						<control type="group"> <!-- Flagging -->
							<left>InlayLeft</left>
							<right>InlayRight</right>
							<!-- <top>InlayTop</top> -->
							<bottom>SpacePadding</bottom>
							<height>26</height>
							<include>openclose</include>
							<include>opencloseslideup</include>
							<control type="group"> <!-- Video Flagging -->
								<left>SpacePadding</left>
								<right>SpacePadding</right>
								<visible>!Container.Content(songs)</visible>
								<control type="grouplist">
									<itemgap>12</itemgap>
									<align>center</align>
									<orientation>horizontal</orientation>
									<include>FlagVideo</include>
									<include>FlagVideoAudioStream1</include>
									<include>FlagVideoAudioStream2</include>
								</control>
							</control>
							<control type="group"> <!-- Music Flagging -->
								<left>SpacePadding</left>
								<right>SpacePadding</right>
								<visible>Container.Content(songs)+!Window.IsVisible(135)</visible>
								<control type="grouplist">
									<itemgap>4</itemgap>
									<align>center</align>
									<orientation>horizontal</orientation>
									<include>FlagMusic</include>
								</control>
							</control>
						</control>
						<include>CommonPageCount</include>
					</control>
				</control>
				<include content="AlphaBarV" condition="!Skin.HasSetting(HideJumpSMSBar)"><param name="id" value="$PARAM[viewid]"/></include>
				<control type="button" id="777">
					<include>HiddenButton</include>
					<onfocus>Control.SetFocus($PARAM[viewid])</onfocus>
				</control>
			</control>
		</definition>
    </include>
</includes>
