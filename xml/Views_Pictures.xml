								</itemlayout>
								<focusedlayout height="216" width="216">
									<control type="image">
										<aspectratio>scale</aspectratio>
										<texture border="4" colordiffuse="grey2">White.png</texture>
										<bordertexture border="10">ThumbShadowWhite.png</bordertexture>
										<bordersize>8</bordersize>
									</control>
									<control type="image">
										<left>15</left>
										<right>15</right>
										<top>15</top>
