			<definition>
			<control type="group">
				<include>openclose</include>
				<visible>Control.IsVisible($PARAM[viewid])</visible>
				<control type="group">
					<include>openclosevisible</include>
					<visible>Control.IsVisible($PARAM[viewid])</visible>
					<include>WhiteGrunge</include>
					<control type="group">
						<control type="group">
							<include>opencloseslidedown</include>
							<left>30</left>
							<right>30</right>
							<top>SpacePaddingXL</top>
							<bottom>SpacePaddingXL</bottom>
							<control type="panel" id="$PARAM[viewid]">
								<left>15</left>
								<right>15</right>
								<top>15</top>
