									</control>
								</focusedlayout>
							</control>
							<include content="DefaultScrollbar">
								<param name="id" value="$PARAM[viewid]1" />
								<param name="left" value="15r" />
								<param name="top" value="0" />
								<param name="height" value="100%" />
								<param name="onleft" value="$PARAM[viewid]" />
							</include>
						</control>
						<include content="MirrorPanel">
							<param name="top" value="70r" />
						</include>
						<control type="group">
							<include>opencloseslideup</include>
							<control type="label">
								<description>Title txt</description>
								<left>45</left>
								<top>1020</top>
								<width>1000</width>
								<height>45</height>
								<label>$INFO[ListItem.FileName]</label>
								<align>left</align>
								<aligny>center</aligny>
								<font>impacted24</font>
								<textcolor>white</textcolor>
							</control>
						</control>
					</control>
					<include content="CommonPageCount">
						<param name="bottom" value="15" />
					</include>
				</control>
				<include content="AlphaBarV" condition="!Skin.HasSetting(HideJumpSMSBar)"><param name="id" value="$PARAM[viewid]"/></include>
