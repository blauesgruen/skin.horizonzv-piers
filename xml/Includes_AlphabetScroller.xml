    <include name="AlphabetScrollerContainer">
        <param name="right" />
        <param name="width">40</param>
        <param name="top">0</param>
        <definition>
            <control type="group">
                <right>$PARAM[right]</right>
                <top>$PARAM[top]</top>
                <width>$PARAM[width]</width>
                <include>openclosevisible</include>
                <visible>!Skin.HasSetting(alphabetscroller_off)+!Container.Content(episodes)</visible>
                <include content="AlphabetScroller">
                    <param name="left" value="0" />
                    <param name="top" value="0" />
                    <param name="visible" value="true" />
                </include>
            </control>
        </definition>
    </include>
