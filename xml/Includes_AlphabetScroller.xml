    <!-- Alphabet Scroller Include -->
    <include name="AlphabetScroller">
        <param name="height">700</param> <!-- 11*spacing + 10*itemgap -->
        <param name="spacing">50</param>
        <param name="itemgap">15</param>
        <param name="fontsize">ubuntu-r16</param>
        <param name="fontsize_active">ubuntu-r21b</param>
        <param name="visible">Container.Scrolling</param>
        <definition>
            <control type="group">
                <centertop>50%</centertop>
                <height>$PARAM[height]</height>
                <visible>String.IsEqual(Container.SortMethod,$LOCALIZE[369]) | String.IsEqual(Container.SortMethod,$LOCALIZE[556]) | String.IsEqual(Container.SortMethod,$LOCALIZE[551])</visible>
                <!-- Fokus-Highlight Hintergrund (immer in der Mitte bei Position 5) -->
                <!-- <control type="group">
                    <centertop>50%</centertop>
                    <height>$PARAM[spacing]</height>
                    <control type="image">
                        <texture colordiffuse="44FFFFFF">White.png</texture>
                    </control>
                </control> -->
                <control type="grouplist">
                    <itemgap>$PARAM[itemgap]</itemgap>
                    <visible>$PARAM[visible]</visible>
                    <include>openclosevisible</include>
                    <!-- 11 feste Label-Positionen -->
                    <!-- Position 0 (-5) -->
                    <control type="label">
                        <height>$PARAM[spacing]</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>$PARAM[fontsize]</font>
                        <textcolor>33FFFFFF</textcolor>
                        <shadowcolor>black</shadowcolor>
                        <label>$VAR[AlphabetPos_Minus5]</label>
                    </control>
                    <!-- Position 1 (-4) -->
                    <control type="label">
                        <height>$PARAM[spacing]</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>$PARAM[fontsize]</font>
                        <textcolor>4DFFFFFF</textcolor>
                        <shadowcolor>black</shadowcolor>
                        <label>$VAR[AlphabetPos_Minus4]</label>
                    </control>
                    <!-- Position 2 (-3) -->
