    <include name="View_10_PVRGuideTimeline">
        <control type="group">
            <description>TV Guide Timeline</description>
            <visible>Control.IsVisible(10)</visible>
            <include>openclose</include>
            <include>opencloseslideup</include>
            <top>22</top>
            <control type="image">
                <top>57</top>
                <bottom>226</bottom>
                <width>101%</width>
                <colordiffuse>menudiffuse</colordiffuse>
                <texture>BlackBack.png</texture>
            </control>
            <control type="image" id="1">
                <left>-8</left>
                <top>42</top>
                <width>100%</width>
                <height>15</height>
                <colordiffuse>fanartdiffuse</colordiffuse>
                <texture>Shadow.png</texture>
            </control>
            <control type="group">
                <bottom>212</bottom>
                <height>15</height>
                <control type="image" id="1">
                    <width>101%</width>
                    <colordiffuse>fanartdiffuse</colordiffuse>
                    <texture flipy="true">Shadow.png</texture>
                </control>
            </control>
            <control type="epggrid" id="10">
                <viewtype label="19032">list</viewtype>
                <description>EPG Grid</description>
                <left>30</left>
                <top>67</top>
                <bottom>236</bottom>
                <pagecontrol>10</pagecontrol>
                <scrolltime>350</scrolltime>
                <timeblocks>30</timeblocks>
                <rulerunit>6</rulerunit>
                <progresstexture border="5" colordiffuse="menudiffuse">PVR-EpgProgressIndicator.png</progresstexture>
                <onleft>9000</onleft>
                <onright>9000</onright>
                <onup>10</onup>
                <ondown>10</ondown>
                <rulerlayout height="52" width="60">
                    <control type="image" id="1">
                        <width>57</width>
                        <height>44</height>
                        <left>0</left>
                        <top>-3</top>
                        <colordiffuse>$VAR[BackgroundOverlayColorDialog]</colordiffuse>
                        <texture>White.png</texture>
                    </control>
                    <control type="label" id="2">
                        <left>15</left>
                        <right>15</right>
                        <top>-2</top>
                        <!-- <width>51</width> -->
                        <height>44</height>
                        <aligny>center</aligny>
                        <align>left</align>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </rulerlayout>
                <channellayout height="80" width="420">
                    <control type="group">
                        <right>10</right>
                        <top>4</top>
                        <bottom>4</bottom>
                        <control type="label">
                            <height>100%</height>
                            <width>55</width>
                            <align>left</align>
                            <textcolor>grey</textcolor>
                            <info>ListItem.ChannelNumberLabel</info>
                        </control>
                        <control type="image">
                            <left>68</left>
                            <width>70</width>
                            <texture fallback="icons/TVShowsIcon.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>!Window.IsVisible(radiochannels)</visible>
                        </control>
                        <control type="image">
                            <left>68</left>
                            <width>70</width>
                            <texture fallback="FallbackRadio.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>Window.IsVisible(radiochannels)</visible>
                        </control>
                        <control type="label" id="1">
                            <left>150</left>
                            <height>100%</height>
                            <aligny>center</aligny>
                            <textcolor>grey</textcolor>
                            <align>left</align>
                            <label>$INFO[ListItem.ChannelName]</label>
                        </control>
                    </control>
                </channellayout>
                <focusedchannellayout height="80" width="420">
                    <control type="group">
                        <right>10</right>
                        <top>4</top>
                        <bottom>4</bottom>
                        <control type="image">
                        <colordiffuse>$VAR[BackgroundOverlayColorDialog]</colordiffuse>
                            <texture border="10" flipx="true">SideFadeWhite.png</texture>
                        </control>
                        <control type="image" id="2">
                            <texture border="5">buttons/ButtonNFhalf.png</texture>
                        </control>
                        <control type="label">
                            <height>100%</height>
                            <width>55</width>
                            <align>left</align>
                            <info>ListItem.ChannelNumberLabel</info>
                        </control>
                        <control type="image">
                            <left>68</left>
                            <width>70</width>
                            <texture fallback="icons/TVShowsIcon.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>!Window.IsVisible(radiochannels)</visible>
                        </control>
                        <control type="image">
                            <left>68</left>
                            <width>70</width>
                            <texture fallback="FallbackRadio.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>Window.IsVisible(radiochannels)</visible>
                        </control>
                        <control type="label" id="1">
                            <left>150</left>
                            <height>100%</height>
                            <aligny>center</aligny>
                            <align>left</align>
                            <label>$INFO[ListItem.ChannelName]</label>
                        </control>
                    </control>
                </focusedchannellayout>
                <itemlayout height="80" width="60">
                    <control type="image" id="2">
                        <width>60</width>
                        <height>78</height>
                        <aspectratio>stretch</aspectratio>
                        <texture border="3">$INFO[ListItem.Property(GenreType),epg-genres/,].png</texture>
                    </control>
                    <control type="label" id="1">
                        <left>8</left>
                        <right>8</right>
                        <height>100%</height>
                        <top>10</top>
                        <bottom>10</bottom>
                        <aligny>top</aligny>
                        <align>left</align>
                        <info>ListItem.Label</info>
                    </control>
                    <include>PVR-TimerIcons</include>
                </itemlayout>
                <focusedlayout height="80" width="60">
                    <control type="image" id="2">
                        <left>2</left>
                        <right>2</right>
                        <top>2</top>
                        <bottom>2</bottom>
                        <aspectratio>stretch</aspectratio>
                        <texture border="3">$INFO[ListItem.Property(GenreType),epg-genres/,].png</texture>
                    </control>
                    <control type="image" id="14">
                        <left>2</left>
                        <right>2</right>
                        <top>2</top>
                        <bottom>2</bottom>
                        <colordiffuse>$VAR[BackgroundOverlayColorDialog]</colordiffuse>
                        <texture>White.png</texture>
                    </control>
                    <control type="im age" id="14">
                        <left>2</left>
                        <right>2</right>
                        <top>2</top>
                        <bottom>2</bottom>
                        <texture border="1">buttons/ButtonNF.png</texture>
                    </control>
                    <control type="image" id="14">
                        <left>2</left>
                        <right>2</right>
                        <top>2</top>
                        <bottom>2</bottom>
                        <texture>GlassOverlay.png</texture>
                    </control>
                    <control type="label" id="1">
                        <left>8</left>
                        <right>8</right>
                        <height>100%</height>
                        <top>10</top>
                        <bottom>10</bottom>
                        <aligny>top</aligny>
                        <align>left</align>
                        <info>ListItem.Label</info>
                    </control>
                    <include>PVR-TimerIcons</include>
                </focusedlayout>
            </control>
            <control type="group">
                <bottom>0</bottom>
                <height>60</height>
                <control type="image" id="1">
                    <texture border="1">BlackBack.png</texture>
                </control>
                <control type="image" id="1">
                    <height>3</height>
                    <colordiffuse>menudiffuse</colordiffuse>
                    <texture border="1">Separator1.png</texture>
                </control>
            </control>
            <control type="group">
                <left>SpacePadding</left>
                <bottom>70</bottom>
                <height>146</height>
                <control type="image">
                    <width>400</width>
                    <texture>$INFO[ListItem.Icon]</texture>
                    <bordersize>icon_padding_m</bordersize>
                    <aspectratio align="right" aligny="center">keep</aspectratio>
                </control>
                <control type="group">
                    <left>420</left>
                    <control type="label">
                        <right>SpacePadding</right>
                        <top>8</top>
                        <width>1320</width>
                        <height>45</height>
                        <aligny>center</aligny>
                        <align>left</align>
                        <shadowcolor>black</shadowcolor>
                        <font>ubuntu-r26b</font>
                        <label>$INFO[ListItem.Label]$INFO[ListItem.StartTime, (,]$INFO[ListItem.EndTime, - ,)]</label>
                    </control>
                    <control type="textbox">
                        <right>SpacePadding</right>
                        <top>60</top>
                        <bottom>0</bottom>
                        <shadowcolor>black</shadowcolor>
                        <include condition="!Skin.HasSetting(BigPlotText)">PlotText16Var</include>
                        <include condition="Skin.HasSetting(BigPlotText)">PlotTextBigVar</include>
                        <label>$INFO[ListItem.Plot]</label>
                    </control>
                </control>
            </control>
            <control type="group">
                <left>SpacePadding</left>
                <bottom>6</bottom>
                <height>45</height>
                <control type="image">
                    <width>45</width>
                    <texture border="3">$INFO[ListItem.Property(GenreType),epg-genres/,].png</texture>
                </control>
                <control type="label">
                    <left>55</left>
                    <height>45</height>
                    <font>impacted21</font>
                    <textcolor>grey</textcolor>
                    <label>$VAR[EpgGenreLabel]</label>
                </control>
            </control>
        </control>
    </include>
    <!-- ID: 11 -->
    <include name="View_11_PVRGuideNow">
        <param name="viewid">11</param>
        <definition>
            <control type="group">
                <description>Recordings group</description>
                <top>318</top>
                <include>openclose</include>
                <include>opencloseslideup</include>
                <visible>Control.IsVisible($PARAM[viewid])</visible>
                <control type="group">
                    <width>50%</width>
                    <control type="group">
                        <top>SpacePadding</top>
                        <bottom>SpacePadding</bottom>
                        <control type="fixedlist" id="$PARAM[viewid]">
                            <left>SpacePaddingLarge</left>
                            <onright>$PARAM[viewid]1</onright>
                            <onleft>9000</onleft>
                            <onup>$PARAM[viewid]</onup>
                            <ondown>$PARAM[viewid]</ondown>
                            <viewtype label="535">list</viewtype>
                            <movement>2</movement>
                            <focusposition>3</focusposition>
                            <pagecontrol>$PARAM[viewid]1</pagecontrol>
                            <scrolltime>200</scrolltime>
                            <orientation>vertical</orientation>
                            <include content="LiveTVChannelViewLayout">
                                <param name="id" value="$PARAM[viewid]" />
                                <param name="item_width" value="auto" />
                            </include>
                        </control>
                        <control type="scrollbar" id="$PARAM[viewid]1">
                            <left>100%</left>
                            <height>100%</height>
                            <onright>9000</onright>
                            <onleft>$PARAM[viewid]</onleft>
                            <showonepage>false</showonepage>
                            <orientation>vertical</orientation>
                        </control>
                    </control>
                </control>
                <control type="group">
                    <width>50%</width>
                    <right>0</right>
                    <control type="group">
                        <left>12</left>
                        <control type="image">
                            <texture>BlackBack.png</texture>
                        </control>
                        <control type="group">
                            <left>SpacePaddingLarge</left>
                            <right>SpacePaddingLarge</right>
                            <bottom>SpacePaddingLarge</bottom>
                            <include>PVRInfoPanel</include>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>
