<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">10</defaultcontrol>
    <onload condition="!String.IsEmpty(Skin.String(start_volume))">SetVolume($INFO[Skin.String(start_volume)])</onload>
    <!-- Start TMDbH service -->
    <onload condition="System.HasAddon(plugin.video.themoviedb.helper)">Skin.SetBool(TMDbHelper.Service)</onload>
    <onload condition="System.HasAddon(plugin.video.themoviedb.helper)">Skin.SetString(TMDbHelper.MonitorContainer,99950)</onload>
    <onload condition="Skin.HasSetting(extendedinfo_music)">Skin.Reset(extendedinfo_music)</onload>
    <controls>
        <control type="button" id="10">
            <description>trigger</description>
            <onfocus>Control.SetFocus(11)</onfocus>
            <texturenofocus/>
            <texturefocus/>
            <visible>!Skin.HasSetting(Use_Startup_Playlist)</visible>
        </control>
        <control type="button" id="10">
            <description>trigger with startup Playlist</description>
            <onfocus>XBMC.PlayMedia($INFO[Skin.String(Startup_Playlist_Path)])</onfocus>
            <onfocus>Control.SetFocus(11)</onfocus>
            <texturenofocus/>
            <texturefocus/>
            <visible>Skin.HasSetting(Use_Startup_Playlist)</visible>
        </control>
        <control type="button" id="11">
            <include>HiddenButton</include>
            <onfocus>ReplaceWindow($INFO[System.StartupWindow])</onfocus>
        </control>
        <control type="image">
            <include>opencloseslideup</include>
            <description>LOGO</description>
            <left>30</left>
            <top>150r</top>
            <width>330</width>
            <height>120</height>
            <aspectratio>keep</aspectratio>
            <texture>Horizonzv.png</texture>
        </control>
    </controls>
</window>
