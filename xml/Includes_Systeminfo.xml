<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="systeminfo">
        <control type="group">
            <bottom>0</bottom>
            <height>260</height>
            <include>openclose</include>
            <include>opencloseslideup</include>
            <include content="MirrorPanel">
                <param name="top" value="250r" />
            </include>
            <control type="grouplist">
                <left>SpacePadding</left>
                <top>SpacePadding</top>
                <width>65%</width>
                <align>left</align>
                <itemgap>-10</itemgap>
                <control type="label">
                    <description>SKIN BUILD Version</description>
					<height>45</height>
                    <align>left</align>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>Skin: $INFO[System.AddonTitle(skin.horizonzv)]$INFO[System.AddonVersion(skin.horizonzv), v,]$INFO[System.AddonTitle(skin.horizonzv.test)]$INFO[System.AddonVersion(skin.horizonzv.test), v,]</label>
                </control>
                <control type="label">
                    <description>KODI XBE BUILD Version</description>
					<height>45</height>
                    <align>left</align>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>KODI $LOCALIZE[144] $INFO[System.BuildVersion]</label>
                </control>
                <control type="label">
                    <description>Kernel</description>
					<height>45</height>
                    <align>left</align>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[System.KernelVersion]</label>
                </control>
                <control type="label">
                    <description>Screen</description>
					<height>45</height>
                    <align>left</align>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[System.ScreenMode]</label>
                </control>
                <control type="label">
                    <description>Network</description>
					<height>45</height>
                    <align>left</align>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>IP: $INFO[Network.IPAddress]</label>
                </control>
                <control type="label">
                    <description>Network</description>
					<height>45</height>
                    <align>left</align>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>MAC: $INFO[Network.MacAddress]</label>
                </control>
            </control>
            <control type="grouplist">
                <right>SpacePadding</right>
                <top>SpacePadding</top>
                <width>35%</width>
                <height>900</height>
                <itemgap>-10</itemgap>
                <control type="label">
                    <description>FPS</description>
					<height>45</height>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>FPS: $INFO[System.FPS]</label>
                </control>
                <control type="label">
                    <description>CpuFrequency</description>
					<height>45</height>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[System.CpuFrequency,$LOCALIZE[13284] ,]$INFO[System.CPUTemperature, • $LOCALIZE[22011] ,]</label>
                </control>
                <control type="label">
                    <description>CPU Text</description>
					<height>45</height>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>$LOCALIZE[13271] $INFO[System.CPUUsage]</label>
                </control>
				<control type="label">
					<description>fake</description>
					<height>20</height>
					<label/>
				</control>
				<control type="progress">
					<description>CPU BAR</description>
					<height>12</height>
					<info>System.CPUUsage</info>
				</control>
				<control type="label">
					<description>fake</description>
					<height>20</height>
					<label/>
				</control>
                <control type="label">
                    <description>Memory Text</description>
					<height>45</height>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>$LOCALIZE[31048] $INFO[system.memory(used.percent)]</label>
                </control>
				<control type="label">
					<description>fake</description>
					<height>20</height>
					<label/>
				</control>
				<control type="progress">
					<description>Memory BAR</description>
					<height>12</height>
					<info>system.memory(used)</info>
				</control>
				<control type="label">
					<description>fake</description>
					<height>20</height>
					<label/>
				</control>
            </control>
        </control>
    </include>
</includes>
