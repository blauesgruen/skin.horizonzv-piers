<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <include>openclose</include>
    <controls>
		<control type="group">
            <include>opencloseslideleft</include>
			<right>InfoSidePanel_Right</right>
			<width>InfoSidePanel_Width</width>
            <include content="InfoSidePanelBackground">
                <param name="header_label"></param>
                <param name="visible_arrows">false</param>
            </include>
			<control type="group">
				<left>20</left>
				<right>20</right>
				<top>30</top>
				<bottom>80</bottom>
                <control type="list" id="11">
                    <top>60</top>
                    <bottom>10</bottom>
                    <onleft>PreviousChannelGroup</onleft>
                    <onright>NextChannelGroup</onright>
                    <onup>11</onup>
                    <ondown>11</ondown>
                    <viewtype label="535">list</viewtype>
                    <focusposition>4</focusposition>
                    <scrolltime>200</scrolltime>
                    <itemlayout height="99">
                        <control type="image">
                            <colordiffuse>fanartdiffuse</colordiffuse>
                            <texture border="5">buttons/ButtonNFlight.png</texture>
                        </control>
                        <control type="group">
                            <right>20</right>
                            <control type="label">
                                <width>60</width>
                                <height>99</height>
                                <font>impacted21</font>
                                <align>right</align>
                                <aligny>center</aligny>
                                <textcolor>grey</textcolor>
                                <info>ListItem.ChannelNumberLabel</info>
                                <visible>!ListItem.IsRecording</visible>
                            </control>
                            <control type="image">
                                <left>30</left>
                                <width>30</width>
                                <height>99</height>
                                <texture>PVR-IsRecording.png</texture>
                                <aspectratio aligny="center">keep</aspectratio>
                                <visible>ListItem.IsRecording</visible>
                            </control>
                            <control type="label">
                                <left>100</left>
                                <height>50</height>
                                <align>left</align>
                                <label>$INFO[ListItem.Label]</label>
                            </control>
                            <control type="label">
                                <top>45</top>
                                <left>100</left>
                                <height>30</height>
                                <align>left</align>
                                <textcolor>grey</textcolor>
                                <label>$LOCALIZE[19055]</label>
                                <font>ubuntu-r13b</font>
                                <visible>!ListItem.HasEpg</visible>
                            </control>
                            <control type="label">
                                <right>80</right>
                                <top>43</top>
                                <left>100</left>
                                <height>30</height>
                                <align>left</align>
                                <font>ubuntu-r18</font>
                                <textcolor>grey</textcolor>
                                <label>$INFO[ListItem.Title]$INFO[ListItem.EndTime(hh:mm), - ,]</label>
                                <visible>ListItem.HasEpg</visible>
                            </control>
                            <control type="progress">
                                <description>Progressbar</description>
                                <top>82</top>
                                <left>100</left>
                                <height>8</height>
                                <colordiffuse>88FFFFFF</colordiffuse>
                                <info>ListItem.Progress</info>
                                <visible>ListItem.HasEpg</visible>
                            </control>
                            <control type="group">
                                <right>0</right>
                                <width>75</width>
                                <control type="image">
                                    <top>10</top>
                                    <height>75</height>
                                    <texture fallback="DefaultAddonNone.png">$INFO[ListItem.Icon]</texture>
                                    <aspectratio>keep</aspectratio>
                                </control>
                            </control>
                        </control>
                    </itemlayout>
                    <focusedlayout height="99">
                        <control type="image">
                            <include>DialogButtonTextureFocus</include>
                        </control>
                        <control type="group">
                            <right>20</right>
                            <control type="label">
                                <width>60</width>
                                <height>99</height>
                                <font>impacted21</font>
                                <align>right</align>
                                <aligny>center</aligny>
                                <textcolor>grey3</textcolor>
                                <info>ListItem.ChannelNumberLabel</info>
                                <visible>!ListItem.IsRecording</visible>
                            </control>
                            <control type="image">
                                <left>30</left>
                                <width>30</width>
                                <height>99</height>
                                <texture>PVR-IsRecording.png</texture>
                                <aspectratio aligny="center">keep</aspectratio>
                                <visible>ListItem.IsRecording</visible>
                            </control>
                            <control type="label">
                                <left>100</left>
                                <height>50</height>
                                <align>left</align>
                                <textcolor>grey3</textcolor>
                                <label>$INFO[ListItem.Label]</label>
                            </control>
                            <control type="label">
                                <top>45</top>
                                <left>100</left>
                                <height>30</height>
                                <align>left</align>
                                <textcolor>grey3</textcolor>
                                <label>$LOCALIZE[19055]</label>
                                <font>ubuntu-r13b</font>
                                <visible>!ListItem.HasEpg</visible>
                            </control>
                            <control type="label">
                                <right>80</right>
                                <top>43</top>
                                <left>100</left>
                                <height>30</height>
                                <align>left</align>
                                <font>ubuntu-r18</font>
                                <textcolor>grey3</textcolor>
                                <label>$INFO[ListItem.Title]$INFO[ListItem.EndTime(hh:mm), - ,]</label>
                                <visible>ListItem.HasEpg</visible>
                            </control>
                            <control type="progress">
                                <description>Progressbar</description>
                                <top>82</top>
                                <left>100</left>
                                <height>8</height>
                                <colordiffuse>88FFFFFF</colordiffuse>
                                <info>ListItem.Progress</info>
                                <visible>ListItem.HasEpg</visible>
                            </control>
                            <control type="group">
                                <right>0</right>
                                <width>75</width>
                                <control type="image">
                                    <top>10</top>
                                    <height>75</height>
                                    <texture fallback="DefaultAddonNone.png">$INFO[ListItem.Icon]</texture>
                                    <aspectratio>keep</aspectratio>
                                </control>
                            </control>
                        </control>
                    </focusedlayout>
                </control>
                <control type="label">
                    <description>header label</description>
                    <height>45</height>
                    <font>impacted18</font>
                    <label>$LOCALIZE[19023] - $INFO[VideoPlayer.ChannelGroup] $INFO[Container(11).NumItems,(,)]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>white</textcolor>
                    <shadowcolor/>
                    <visible>!pvr.IsPlayingRadio</visible>
                </control>
                <control type="label">
                    <description>header label</description>
                    <height>45</height>
                    <font>impacted18</font>
                    <label>$LOCALIZE[19024] - $INFO[MusicPlayer.ChannelGroup] $INFO[Container(11).NumItems,(,)]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>white</textcolor>
                    <shadowcolor/>
                    <visible>pvr.IsPlayingRadio</visible>
                </control>
            </control>
            <control type="group">
                <bottom>30</bottom>
                <height>45</height>
                <control type="label">
                    <description>header label</description>
                    <height>45</height>
                    <font>impacted18</font>
                    <label>$INFO[System.Date(DDD)], $INFO[System.Date(d)] $INFO[System.Date(mmm)] $INFO[System.Date(yyyy)] • $INFO[System.Time]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>grey</textcolor>
                    <shadowcolor/>
                </control>
            </control>
        </control>
    </controls>
</window>
