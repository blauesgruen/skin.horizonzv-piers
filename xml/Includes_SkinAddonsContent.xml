<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="SkinAddonListLayout">
		<param name="id" default="18000"/>
		<param name="left" default="15"/>
		<param name="top" default="0"/>
		<param name="width" default="1165"/>
		<param name="height" default="698"/>
		<param name="item_height" default="53"/>
		<param name="onleft" default=""/>
		<param name="visible" default="true"/>
		<param name="visible" default="true"/>
		<param name="itemlayouttextcolor" default="white"/>
		<param name="focusedtextcolor" default="grey3"/>
		<param name="pagecontrol" default="70"/>
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<onup>$PARAM[id]</onup>
				<ondown>$PARAM[id]</ondown>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[pagecontrol]</onright>
				<visible>$PARAM[visible]</visible>
				<include>openclosevisible</include>
				<scrolltime tween="Quadratic" easing="out">500</scrolltime>
				<focusposition>0</focusposition>
				<orientation>vertical</orientation>
				<pagecontrol>$PARAM[pagecontrol]</pagecontrol>
				<movement>1</movement>
				<itemlayout height="$PARAM[item_height]" width="auto">
					<control type="label">
						<left>30</left>
						<height>$PARAM[item_height]</height>
						<textcolor>$PARAM[itemlayouttextcolor]</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<align>left</align>
					</control>
					<control type="label">
						<right>20</right>
						<height>$PARAM[item_height]</height>
						<textcolor>$PARAM[itemlayouttextcolor]</textcolor>
						<label>$INFO[ListItem.Label2]</label>
						<align>right</align>
					</control>
					<control type="image">
						<left>56r</left>
						<width>36</width>
						<aspectratio>keep</aspectratio>
						<texture>$INFO[ListItem.Icon]</texture>
					</control>
				</itemlayout>
				<focusedlayout height="$PARAM[item_height]" width="auto">
					<control type="image">
						<left>15</left>
						<include>DialogButtonTextureFocus</include>
						<visible>Control.HasFocus($PARAM[id])</visible>
					</control>
					<control type="label">
						<left>30</left>
						<height>$PARAM[item_height]</height>
						<textcolor>$PARAM[focusedtextcolor]</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<align>left</align>
						<visible>Control.HasFocus($PARAM[id])</visible>
					</control>
					<control type="label">
						<right>20</right>
						<height>$PARAM[item_height]</height>
						<textcolor>$PARAM[focusedtextcolor]</textcolor>
						<label>$INFO[ListItem.Label2]</label>
						<align>right</align>
						<visible>Control.HasFocus($PARAM[id])</visible>
					</control>
					<control type="image">
						<left>56r</left>
						<width>36</width>
						<colordiffuse>$PARAM[focusedtextcolor]</colordiffuse>
						<aspectratio>keep</aspectratio>
						<texture>$INFO[ListItem.Icon]</texture>
						<visible>Control.HasFocus($PARAM[id])</visible>
					</control>
					<!-- unfocus -->
					<control type="label">
						<left>30</left>
						<height>$PARAM[item_height]</height>
						<textcolor>$PARAM[itemlayouttextcolor]</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<align>left</align>
						<visible>!Control.HasFocus($PARAM[id])</visible>
					</control>
					<control type="label">
						<right>20</right>
						<height>$PARAM[item_height]</height>
						<textcolor>$PARAM[itemlayouttextcolor]</textcolor>
						<label>$INFO[ListItem.Label2]</label>
						<align>right</align>
						<visible>!Control.HasFocus($PARAM[id])</visible>
					</control>
					<control type="image">
						<left>56r</left>
						<width>36</width>
						<colordiffuse>$PARAM[itemlayouttextcolor]</colordiffuse>
						<aspectratio>keep</aspectratio>
						<texture>$INFO[ListItem.Icon]</texture>
						<visible>!Control.HasFocus($PARAM[id])</visible>
					</control>
				</focusedlayout>
				<include>SkinAddonContent</include>
			</control>
		</definition>
	</include>
