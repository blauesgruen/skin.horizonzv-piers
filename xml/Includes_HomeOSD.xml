                        </control>
                    </control>
                </control>
            </control>
            <control type="group">
                <include>opencloseslideright</include>
                <visible>!Control.HasFocus(20)</visible>
				<visible>!String.IsEqual(Container(9000).ListItem.Property(homemenu_id),dashboard)</visible>
