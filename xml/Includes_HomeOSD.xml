                    <height>HomeMenuBoxHeight</height>
                    <bottom>0</bottom>
                    <visible>Skin.HasSetting(EnableExtendedArt)+Player.HasAudio+!Control.HasFocus(200)</visible>
                    <control type="group">
                        <top>146</top>
