                                            <height>41</height>
                                            <colordiffuse>grey1</colordiffuse>
                                            <texture>$INFO[ListItem.Icon]</texture>
                                            <visible>!Control.HasFocus(600)</visible>
                                        </control>
                                    </focusedlayout>
