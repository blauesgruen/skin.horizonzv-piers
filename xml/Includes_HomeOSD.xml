                                            <colordiffuse>red</colordiffuse>
                                            <texture border="1">$INFO[ListItem.Property(record)]</texture>
                                            <visible>PVR.IsRecordingPlayingChannel</visible>
                                        </control>
                                        <control type="image">
                                            <left>3</left>
                                            <top>3</top>
                                            <width>39</width>
                                            <height>39</height>
                                            <colordiffuse>description</colordiffuse>
                                            <texture>osd/Ring.png</texture>
                                            <visible>Control.HasFocus(600)</visible>
                                        </control>
                                        <control type="image">
                                            <left>0</left>
                                            <top>0</top>
                                            <width>45</width>
                                            <height>45</height>
                                            <colordiffuse>description</colordiffuse>
                                            <texture>$INFO[ListItem.Icon]</texture>
                                            <visible>Control.HasFocus(600)</visible>
                                        </control>
                                        <control type="image">
                                            <left>0</left>
                                            <top>0</top>
                                            <width>45</width>
                                            <height>45</height>
                                            <colordiffuse>grey1</colordiffuse>
                                            <texture>$INFO[ListItem.Icon]</texture>
                                            <visible>!Control.HasFocus(600)</visible>
                                        </control>
                                    </focusedlayout>
                                    <content>
                                        <item id="0">
                                            <label>19019</label>
                                            <icon>osd/ChannelList.png</icon>
                                            <onclick>ActivateWindow(PVRosdChannels)</onclick>
                                        </item>
                                        <!-- <item id="1">
                                            <label>19222</label>
                                            <icon>osd/EPG.png</icon>
                                            <onclick>ActivateWindowAndFocus(pvrchannelguide)</onclick>
                                        </item> -->
                                        <item id="2">
                                            <label>210</label>
                                            <icon>osd/ChannelUp.png</icon>
                                            <onclick>PlayerControl(Previous)</onclick>
                                        </item>
                                        <item id="3">
                                            <label>209</label>
                                            <icon>osd/ChannelDown.png</icon>
                                            <onclick>PlayerControl(Next)</onclick>
                                        </item>
                                        <item id="4">
                                            <label>31059</label>
                                            <icon>osd/Stop.png</icon>
                                            <onclick>PlayerControl(Stop)</onclick>
                                            <onclick>Control.SetFocus(9000)</onclick>
                                        </item>
                                        <item id="5">
                                            <label>112</label>
                                            <icon>osd/Pause.png</icon>
                                            <onclick>PlayerControl(Play)</onclick>
                                            <visible>PVR.CanRecordPlayingChannel</visible>
