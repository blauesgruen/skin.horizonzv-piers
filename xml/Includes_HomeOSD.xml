                                            <icon>osd/NextTrack.png</icon>
                                            <onclick>PlayerControl(Next)</onclick>
                                        </item>
                                        <item id="7">
                                            <label>244</label>
                                            <icon>osd/GoFullscreen.png</icon>
                                            <onclick>fullscreen</onclick>
                                        </item>
                                    </content>
                                </control>
