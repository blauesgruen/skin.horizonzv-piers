                                <width>399</width>
                                <aspectratio align="left" aligny="bottom">stretch</aspectratio>
                                <texture diffuse="masks/ClearArtMask.png">$VAR[homecover_icon]</texture>
                            </control>
                            <control type="image">
                                <left>12</left>
                                <top>405</top>
                                <width>120</width>
                                <height>120</height>
                                <texture>$VAR[OSDTexture]</texture>
                            </control>
                            <control type="group">
                                <include>opencloseslow</include>
                                <control type="label">
                                    <left>180</left>
                                    <top>460</top>
                                    <width>615</width>
                                    <height>45</height>
                                    <font>impacted18</font>
                                    <textcolor>white</textcolor>
                                    <shadowcolor/>
                                    <label>$VAR[HomeOSDTitle]</label>
                                </control>
                                <control type="label">
                                    <left>180</left>
                                    <top>496</top>
                                    <width>630</width>
                                    <height>45</height>
                                    <font>impacted21</font>
                                    <textcolor>white</textcolor>
                                    <shadowcolor/>
                                    <label>$VAR[HomeOSDLabel]</label>
                                </control>
                                <control type="progress">
