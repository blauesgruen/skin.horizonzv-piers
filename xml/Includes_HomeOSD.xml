                        <control type="label">
                            <left>180</left>
                            <height>100%</height>
                            <align>center</align>
                            <aligny>center</aligny>
                            <font>impacted26</font>
                            <textcolor>white</textcolor>
                            <label>$VAR[HomeOSDTitle]$VAR[HomeOSDLabel, [COLOR=description]•[/COLOR] ,]</label>
