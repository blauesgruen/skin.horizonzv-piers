                            <include>opencloseslow</include>
                            <texture diffuse="masks/mask_flagging.png">$VAR[ClearlogoVAR]</texture>
                        </control>
                    </control>
                </control>
                <control type="group">
                    <height>HomeWidgetHeight</height>
                    <control type="group">
                        <height>540</height>
                        <bottom>-55</bottom>
