<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">2</defaultcontrol>
	<backgroundcolor>grey3</backgroundcolor>
    <include>openclose</include>
    <controls>
        <include>DialogBackgroundSimple</include>
        <control type="group">
			<visible>!Window.IsVisible(130)</visible>
            <include>openclosebox</include>
            <include content="DialogBackgroundCommons">
                <param name="width" value="1650" />
                <param name="height" value="900" />
                <param name="header_id" value="1" />
                <param name="header_label" value="10034" />
            </include>
            <control type="group">
                <left>SpacePadding</left>
                <right>SpacePadding</right>
                <top>SpacePaddingXL</top>
                <bottom>SpacePaddingXL</bottom>
                <control type="group">
                <width>400</width>
                    <control type="grouplist">
                        <control type="radiobutton" id="4">
                            <description>Enable Login screen</description>
                            <width>100%</width>
                            <textoffsety>6</textoffsety>
                            <label>20096</label>
                            <align>left</align>
                            <include>DialogButtonTextureFocus</include>
                            <include>DialogButtonTextureNoFocus</include>
                            <onleft>2</onleft>
                            <onright>2</onright>
                            <onup>6</onup>
                            <ondown>5</ondown>
                            <enable>!Window.IsVisible(ProfileSettings)</enable>
                        </control>
                        <control type="button" id="9">
                            <description>Choose auto login user (grayed out)</description>
                            <width>100%</width>
                            <label>33084</label>
                            <textcolor>grey2</textcolor>
                            <include>DialogButtonTextureFocus</include>
                            <include>DialogButtonTextureNoFocus</include>
                            <onleft>2</onleft>
                            <onright>2</onright>
                            <onup>4</onup>
                            <ondown>6</ondown>
                            <visible>System.HasLoginScreen</visible>
                            <enable>false</enable>
                        </control>
                        <control type="button" id="5">
                            <description>Choose auto login user</description>
                            <width>100%</width>
                            <label>33084</label>
                            <include>DialogButtonTextureFocus</include>
                            <include>DialogButtonTextureNoFocus</include>
                            <onleft>2</onleft>
                            <onright>2</onright>
                            <onup>4</onup>
                            <ondown>6</ondown>
                            <visible>!System.HasLoginScreen</visible>
                            <enable>!Window.IsVisible(ProfileSettings) + !System.HasLoginScreen</enable>
                        </control>
                        <control type="label" id="7">
                            <width>100%</width>
                            <textcolor>selected</textcolor>
                            <font>font16</font>
                            <align>center</align>
                            <aligny>center</aligny>
                            <label>$INFO[System.ProfileAutoLogin]</label>
                            <visible>!Control.HasFocus(5) + !System.HasLoginScreen</visible>
                        </control>
                        <control type="label" id="8">
                            <width>100%</width>
                            <textcolor>selected</textcolor>
                            <font>font16</font>
                            <align>center</align>
                            <aligny>center</aligny>
                            <label>$INFO[System.ProfileAutoLogin]</label>
                            <scroll>true</scroll>
                            <scrollspeed>30</scrollspeed>
                            <visible>Control.HasFocus(5) + !System.HasLoginScreen</visible>
                        </control>
                        <control type="button" id="6">
                            <description>Cancel</description>
                            <width>100%</width>
                            <onclick>Action(back)</onclick>
                            <label>301344</label>
                            <include>DialogButtonTextureFocus</include>
                            <include>DialogButtonTextureNoFocus</include>
                            <onleft/>
                            <onright>2</onright>
                            <onup>5</onup>
                            <ondown>4</ondown>
                        </control>
                    </control>
                    <control type="group">
                        <bottom>0</bottom>
                        <height>300</height>
                        <control type="image">
                            <aspectratio>keep</aspectratio>
                            <bordertexture border="10">ThumbShadow.png</bordertexture>
                            <bordersize>6</bordersize>
                            <texture fallback="DefaultUser.png">$INFO[Container(2).Listitem.Icon]</texture>
                        </control>
                    </control>
                </control>
                <control type="image">
                    <left>420</left>
                    <width>3</width>
                    <colordiffuse>fanartdiffuse</colordiffuse>
