                    <left>440</left>
                    <right>15</right>
                    <onleft>4</onleft>
                    <onright>60</onright>
                    <onup>53</onup>
                    <ondown>53</ondown>
                    <viewtype label="21371">list</viewtype>
                    <pagecontrol>60</pagecontrol>
                    <scrolltime>200</scrolltime>
                    <itemlayout height="248" width="218">
