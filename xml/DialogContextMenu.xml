<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>996</defaultcontrol>
    <include>openclose</include>
    <include>openclosebox</include>
	<coordinates>
		<left>-1920</left>
		<top>-1080</top>
	</coordinates>
	<controls>
        <control type="image">
            <left>-1920</left>
            <top>-1080</top>
            <texture>BlackBack.png</texture>
        </control>
		<control type="button">
			<left>-1920</left>
			<top>-1080</top>
			<width>5760</width>
			<height>3240</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>450</width>
            <height>500</height>
			<!-- <animation effect="slide" end="580" time="0" condition="Window.IsActive(home)">conditional</animation> -->
			<control type="image" id="999">
				<description>background image</description>
                <left>-10</left>
				<top>-10</top>
				<height>800</height>
				<colordiffuse>$VAR[BackgroundOverlayColorDialog]</colordiffuse>
				<texture>White.png</texture>
			</control>
			<control type="grouplist" id="996">
				<description>grouplist for context buttons</description>
				<left>0</left>
				<top>0</top>
                <bottom>20</bottom>
				<width>450</width>
				<height max="780">auto</height>
                <itemgap>0</itemgap>
				<usecontrolcoords>false</usecontrolcoords>
			</control>
		</control>
		<control type="group">
            <width>440</width>
            <control type="button" id="1000">
                <description>button template</description>
                <left>10</left>
                <height>45</height>
                <width>100%</width>
                <align>center</align>
                <texturenofocus colordiffuse="grey3">White.png</texturenofocus>
            </control>
		</control>
	</controls>
</window>
