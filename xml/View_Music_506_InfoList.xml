<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="View_506_InfoListMusic">
		<param name="viewid">506</param>
		<definition>
			<control type="group">
				<visible>Control.IsVisible($PARAM[viewid])</visible>
				<include>openclose</include>
				<include>MirrorPanel</include>
				<control type="group"> <!-- Left Panel -->
					<include>opencloseslideright</include>
					<include content="InfoListPanel">
						<param name="left" value="InlayLeftSmall" />
						<param name="right" value="InlayRightSmall" />
					</include>
					<control type="group">
						<left>InlayLeftSmall</left>
						<right>InlayRightSmall</right>
						<top>InlayTop</top>
						<bottom>InlayBottom</bottom>
						<control type="list" id="$PARAM[viewid]">
							<left>60</left>
							<right>75</right>
							<top>80</top>
							<bottom>80</bottom>
							<onleft>9000</onleft>
							<onright condition="Control.IsVisible($PARAM[viewid]1)">$PARAM[viewid]1</onright>
							<onright condition="!Control.IsVisible($PARAM[viewid]1)+Control.IsVisible(15000)">15000</onright>
							<onright condition="!Control.IsVisible($PARAM[viewid]1)+!Control.IsVisible(15000)">732</onright>
							<onup>$PARAM[viewid]</onup>
							<ondown>$PARAM[viewid]</ondown>
							<pagecontrol>$PARAM[viewid]1</pagecontrol>
							<viewtype label="$LOCALIZE[544]">list</viewtype>
							<scrolltime>200</scrolltime>
							<!-- <visible>Container.Content(artists)</visible> -->
							<itemlayout height="60" width="auto" condition="!Container.Content(songs)">
								<control type="label">
									<left>15</left>
									<top>3</top>
									<height>60</height>
									<textcolor>grey</textcolor>
									<align>left</align>
									<aligny>center</aligny>
									<label>$INFO[ListItem.Label]</label>
								</control>
								<control type="label">
									<left>82</left>
									<top>3</top>
									<height>60</height>
									<textcolor>grey</textcolor>
									<align>right</align>
									<aligny>center</aligny>
									<font>font16</font>
									<label>$VAR[InfoWallBottomLabel1Var]</label>
								</control>
							</itemlayout>
							<focusedlayout height="60" width="auto" condition="!Container.Content(songs)">
								<control type="group">
									<control type="image">
										<left>0</left>
										<top>3</top>
										<height>60</height>
										<colordiffuse>grey2</colordiffuse>
										<texture border="5">buttons/ButtonFOlightGlow.png</texture>
										<visible>!Control.HasFocus($PARAM[viewid])</visible>
										<include>openclosevisible</include>
									</control>
									<control type="image">
										<left>0</left>
										<top>3</top>
										<height>60</height>
										<colordiffuse>grey1</colordiffuse>
										<texture border="5">buttons/ButtonFOlightGlow.png</texture>
										<visible>Control.HasFocus($PARAM[viewid])</visible>
										<include>openclosevisible</include>
									</control>
									<control type="label">
										<left>15</left>
										<top>3</top>
										<height>60</height>
										<textcolor>white</textcolor>
										<align>left</align>
										<aligny>center</aligny>
										<label>$INFO[ListItem.Label]</label>
										<shadowcolor>black</shadowcolor>
									</control>
									<control type="label">
										<left>82</left>
										<top>3</top>
										<height>60</height>
										<textcolor>white</textcolor>
										<align>right</align>
										<aligny>center</aligny>
										<font>font16</font>
										<shadowcolor>black</shadowcolor>
										<label>$VAR[InfoWallBottomLabel1Var]</label>
									</control>
								</control>
							</focusedlayout>
							<itemlayout height="60" width="auto" condition="Container.Content(songs)">
								<control type="label">
									<left>15</left>
									<top>3</top>
									<height>60</height>
									<textcolor>grey</textcolor>
									<align>left</align>
									<aligny>center</aligny>
									<label>$INFO[ListItem.Title]</label>
								</control>
								<control type="label">
									<left>82</left>
									<top>3</top>
									<height>60</height>
									<textcolor>grey</textcolor>
									<align>right</align>
									<aligny>center</aligny>
									<font>font16</font>
									<label>$VAR[InfoWallBottomLabel1Var]</label>
								</control>
							</itemlayout>
							<focusedlayout height="60" width="auto" condition="Container.Content(songs)">
								<control type="group">
									<control type="image">
										<left>0</left>
										<top>3</top>
										<height>60</height>
										<colordiffuse>grey2</colordiffuse>
										<texture border="5">buttons/ButtonFOlightGlow.png</texture>
										<visible>!Control.HasFocus($PARAM[viewid])</visible>
										<include>openclosevisible</include>
									</control>
									<control type="image">
										<left>0</left>
										<top>3</top>
										<height>60</height>
										<colordiffuse>grey1</colordiffuse>
										<texture border="5">buttons/ButtonFOlightGlow.png</texture>
										<visible>Control.HasFocus($PARAM[viewid])</visible>
										<include>openclosevisible</include>
									</control>
									<control type="label">
										<left>15</left>
										<top>3</top>
										<height>60</height>
										<textcolor>white</textcolor>
										<align>left</align>
										<aligny>center</aligny>
										<label>$INFO[ListItem.Title]</label>
										<shadowcolor>black</shadowcolor>
									</control>
									<control type="label">
										<left>82</left>
										<top>3</top>
										<height>60</height>
										<textcolor>white</textcolor>
										<align>right</align>
										<aligny>center</aligny>
										<font>font16</font>
										<shadowcolor>black</shadowcolor>
										<label>$VAR[InfoWallBottomLabel1Var]</label>
									</control>
								</control>
							</focusedlayout>
						</control>
						<include content="DefaultScrollbar">
							<param name="top" value="80" />
							<param name="bottom" value="80" />
							<param name="id" value="$PARAM[viewid]1" />
							<param name="left" value="60r" />
							<param name="height" value="100%" />
							<param name="onleft" value="$PARAM[viewid]" />
						</include>
					</control>
				</control>
				<control type="group"> <!-- Right Panel -->
					<include>opencloseslideleft</include>
					<include content="InfoListPanel">
						<param name="left" value="InlayRest" />
						<param name="right" value="InlayLeftSmall" />
					</include>
					<control type="group">
						<left>InlayRest</left>
						<right>InlayLeftSmall</right>
						<top>50</top>
						<bottom>60</bottom>
						<control type="group">
							<left>SpacePaddingLarge</left>
							<right>SpacePaddingLarge</right>
							<top>SpacePaddingLarge</top>
							<bottom>SpacePaddingXL</bottom>
							<control type="image">
								<top>20</top>
								<height>350</height>
								<aspectratio>keep</aspectratio>
								<texture border="4">$VAR[PosterThumb]</texture>
							</control>
							<control type="group">
								<top>390</top>
                                <control type="image">
                                    <height>3</height>
                                    <colordiffuse>fanartdiffuse</colordiffuse>
                                    <texture border="1">Separator1.png</texture>
                                </control>
                                <control type="grouplist">
                                    <top>20</top>
                                    <bottom>10</bottom>
                                    <orientation>vertical</orientation>
                                    <include>openclosemedium</include>
                                    <!-- <visible>Container.Content(Albums)</visible> -->
                                    <visible>!ListItem.IsParentFolder</visible>
                                    <include>MediaInfoContent_Music</include>
                                </control>
							</control>
						</control>
					</control>
				</control>
                <control type="grouplist">
                    <left>InlayLeftSmall</left>
                    <right>InlayRightSmall</right>
                    <top>60r</top>
                    <height>60</height>
                    <align>center</align>
                    <itemgap>1</itemgap>
                    <orientation>horizontal</orientation>
                    <include>FlagMusic</include>
