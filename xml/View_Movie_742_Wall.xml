                                <visible>!String.Contains(Control.GetLabel(9999),Empty.png)</visible>
                                <include>openclosevisible</include>
                            </control>
                            <control type="image">
                                <width>3</width>
                                <texture border="1">Separator3.png</texture>
                                <visible>!String.Contains(Control.GetLabel(9999),Empty.png)+!String.IsEmpty(Control.GetLabel(9998))</visible>
                                <include>openclosevisible</include>
                            </control>
                            <control type="image">
                                <width>260</width>
                                <aspectratio align="center">keep</aspectratio>
                                <texture>$VAR[ClearlogoVAR]</texture>
                                <visible>Skin.HasSetting(EnableExtendedArt)+!String.IsEmpty(Control.GetLabel(9998))</visible>
                                <include>openclosevisible</include>
