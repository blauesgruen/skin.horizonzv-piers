<?xml version="1.0" encoding="UTF-8"?>
<window>
	<include>openclosevisible</include>
	<controls>
		<include>BlackBack</include>
        <control type="group">
            <include>openclosebox</include>
			<include content="DialogBackgroundCommons">
				<param name="width" value="70%" />
				<param name="height" value="70%" />
				<param name="header_id" value="2" />
			</include>
			<control type="group">
				<left>SpacePadding</left>
				<right>SpacePadding</right>
				<top>SpacePaddingXL</top>
				<bottom>SpacePaddingXL</bottom>
				<control type="group">
					<right>350</right>
					<control type="image">
						<top>40</top>
						<width>400</width>
						<texture>$VAR[PosterThumb]</texture>
						<aspectratio aligny="top">keep</aspectratio>
					</control>
					<control type="label">
						<description>Path label</description>
						<top>-20</top>
						<height>40</height>
						<font>font12</font>
						<align>left</align>
						<textcolor>grey</textcolor>
						<label>$INFO[Container(50).ListItem.FileNameAndPath]</label>
					</control>
					<control type="group" id="100">
						<left>420</left>
						<right>0</right>
						<top>40</top>
						<control type="image">
							<colordiffuse>fanartdiffuse</colordiffuse>
							<texture border="5">buttons/KeyboardEditArea.png</texture>
						</control>
						<control type="group">
							<top>10</top>
							<bottom>10</bottom>
							<control type="list" id="50">
								<left>10</left>
								<right>10</right>
								<description>version list</description>
								<onup>50</onup>
								<ondown>50</ondown>
								<onleft>9001</onleft>
								<onright>60</onright>
								<pagecontrol>60</pagecontrol>
								<scrolltime>200</scrolltime>
								<include>DefaultMediaInfoListLayout</include>
							</control>
							<control type="scrollbar" id="60">
								<left>100%</left>
								<width>12</width>
								<height>100%</height>
								<onleft>50</onleft>
								<onright>101</onright>
								<orientation>vertical</orientation>
							</control>
						</control>
					</control>
				</control>
				<control type="grouplist" id="101">
					<top>40</top>
					<right>0</right>
					<width>300</width>
					<onleft condition="Integer.IsGreater(Container(50).NumItems,0)">100</onleft>
					<itemgap>dialogbuttons_itemgap</itemgap>
					<align>top</align>
					<scrolltime tween="quadratic">200</scrolltime>
					<include content="DefaultDialogButton">
						<param name="id" value="21" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[208]" />
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="22" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[40014]" />
						<param name="visible">Window.IsVisible(managevideoversions)</param>
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="23" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[40015]" />
						<param name="visible">Window.IsVisible(managevideoextras)</param>
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="27" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[13511]" />
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="24" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[40004]" />
						<param name="visible">Window.IsVisible(managevideoversions)</param>
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="28" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[118]" />
						<param name="visible">Window.IsVisible(managevideoextras)</param>
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="26" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[15015]" />
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="25" />
						<param name="width" value="100%" />
						<param name="label" value="$LOCALIZE[40023]" />
						<param name="visible">Window.IsVisible(managevideoversions)</param>
					</include>
				</control>
			</control>
			<control type="group">
				<centerleft>50%</centerleft>
				<bottom>0</bottom>
				<width>50%</width>
				<height>54</height>
				<control type="label">
					<align>center</align>
					<!-- <textcolor>grey</textcolor> -->
					<label>$VAR[SelectLabel]</label>
				</control>
			</control>
		</control>
	</controls>
</window>

