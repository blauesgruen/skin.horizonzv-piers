<?xml version="1.0" encoding="utf-8"?>
<includes>
    <include name="WeatherContentDefaultItem">
        <item>
            <label>$INFO[Weather.Data(Day$PARAM[day_id].Title)]</label>
            <label2>$INFO[Weather.Data(Day$PARAM[day_id].LowTemp)] / $INFO[Weather.Data(Day$PARAM[day_id].HighTemp)]</label2>
            <icon>$VAR[WeatherIconVar]$INFO[Weather.Data(Day$PARAM[day_id].Fanartcode)]$VAR[WeatherIconFolderVar]</icon>
            <onclick>ActivateWindow(weather)</onclick>
            <visible>Weather.IsFetched + String.IsEmpty(Weather.Data(Daily.IsFetched))</visible>
            <visible>$PARAM[visible]</visible>
        </item>
    </include>
    <include name="WeatherContentDailyItem">
        <item>
            <label>$INFO[Weather.Data(Daily.$PARAM[day_id].ShortDay)]</label>
            <label2>$INFO[Weather.Data(Daily.$PARAM[day_id].HighTemperature),, 7] $INFO[Weather.Data(Daily.$PARAM[day_id].LowTemperature)]</label2>
            <icon>$VAR[WeatherIconVar]$INFO[Weather.Data(Daily.$PARAM[day_id].FanartCode)]$VAR[WeatherIconFolderVar]</icon>
            <onclick>ActivateWindow(weather)</onclick>
            <visible>Weather.IsFetched + !String.IsEmpty(Weather.Data(Daily.IsFetched))</visible>
            <visible>$PARAM[visible]</visible>
        </item>
    </include>
</includes>
