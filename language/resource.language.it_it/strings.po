msgid ""
msgstr "Inicia la lista de reproducción seleccionada después de iniciar KODI."

msgctxt "#31209"
msgid ""
msgstr "Para utilizar esta función se requiere el addon \'Búsqueda Global\' del repositorio oficial."

msgctxt "#31210"
msgid ""
msgstr "Muestra una pequeña estadística sobre las entradas de la base de datos en la parte inferior derecha del menú principal."

msgctxt "#31211"
msgid ""
msgstr "Muestra los favoritos debajo del menú principal en lugar de directamente la \'Central\'.[CR]De lo contrario, se puede acceder a ellos a través de la \'Central\'."

msgctxt "#31212"
msgid ""
msgstr "Oculta la \'Central\' situada debajo del menú principal."

msgctxt "#31213"
msgid ""
msgstr "Activa un icono en la esquina superior derecha que muestra el estado de carga de la batería.[CR][COLOR=blanco]La visualización incorrecta se produce en ordenadores sin batería.[/COLOR]"

