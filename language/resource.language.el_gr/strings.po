msgid ""
msgstr "Puts a texture over the background image."

msgctxt "#301186"
msgid ""
msgstr "Εμφανίζει τα χειριστήρια του player κατά την αναπαραγωγή στα αριστερά, κάτω από το κύριο μενού."

msgctxt "#301188"
msgid ""
msgstr "Εμφανίζει τον τρέχοντα καιρό στην επάνω αριστερή γωνία."

msgctxt "#301190"
msgid ""
